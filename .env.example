# 本地开发用的环境变量（复制成 .env.local 后填写）
# 只在本机 `npm run dev` 时使用；部署到 Vercel 时请在 Vercel 后台配置同名变量。

# 1) 数据存哪里（三选一，都不配就用本地文件 .local-data/data.json）

# ① Postgres（推荐：Neon / Vercel Postgres / Supabase 都行）
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ② Upstash Redis（Vercel 控制台 Storage 里一键创建，自动注入 KV_REST_API_*）
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxx

# ③ 本地 JSON 文件（默认，仅本机可用，Vercel 上不可写）
# DATA_FILE=./.local-data/data.json

# 2) 签名密钥：随便一串长随机字符，改了会让所有人重新登录一次
APP_SECRET=change-me-to-a-long-random-string

# 3) 可选：用环境变量预设小组口令（配了之后进站提示会用它，口令不再存数据库）
# SITE_PASSCODE=hw2025
